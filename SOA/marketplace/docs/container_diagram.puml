@startuml ContainerDiagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Marketplace - Container Diagram

Person(buyer, "Покупатель")
Person(seller, "Продавец")

System_Boundary(marketplace, "Marketplace Platform") {

    Container(apiGateway, "API Gateway", "Nginx / REST", "Единая точка входа, маршрутизация запросов")

    Container(authService, "Auth Service", "REST API", "Аутентификация и авторизация пользователей")

    Container(userService, "User Service", "REST API", "Управление пользователями (покупатели, продавцы)")

    Container(productService, "Product Catalog Service", "REST API", "Управление каталогом товаров")

    Container(orderService, "Order Service", "REST API", "Создание и управление заказами")

    Container(paymentService, "Payment Service", "REST API", "Обработка и учёт платежей")

    Container(recommendationService, "Recommendation Service", "REST + Event Consumer", "Формирование персонализированной ленты")

    Container(notificationService, "Notification Service", "Event Consumer", "Отправка уведомлений")

    ContainerDb(userDb, "User DB", "PostgreSQL")
    ContainerDb(productDb, "Product DB", "PostgreSQL")
    ContainerDb(orderDb, "Order DB", "PostgreSQL")
    ContainerDb(paymentDb, "Payment DB", "PostgreSQL")

    Container(messageBroker, "Message Broker", "Kafka / RabbitMQ", "Асинхронное взаимодействие сервисов")
}

System_Ext(paymentProvider, "Payment Provider")
System_Ext(notificationProvider, "Email/SMS Provider")

Rel(buyer, apiGateway, "HTTPS")
Rel(seller, apiGateway, "HTTPS")

Rel(apiGateway, authService, "REST")
Rel(apiGateway, userService, "REST")
Rel(apiGateway, productService, "REST")
Rel(apiGateway, orderService, "REST")
Rel(apiGateway, recommendationService, "REST")

Rel(orderService, paymentService, "REST")
Rel(paymentService, paymentProvider, "HTTPS")

Rel(orderService, messageBroker, "Publish order.created")
Rel(paymentService, messageBroker, "Publish payment.completed")

Rel(messageBroker, notificationService, "Consume events")
Rel(messageBroker, recommendationService, "Consume events")

Rel(notificationService, notificationProvider, "Send notifications")

Rel(userService, userDb, "CRUD")
Rel(productService, productDb, "CRUD")
Rel(orderService, orderDb, "CRUD")
Rel(paymentService, paymentDb, "CRUD")

@enduml
